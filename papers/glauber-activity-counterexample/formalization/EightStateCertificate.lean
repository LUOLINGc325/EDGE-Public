  norm_num [ratActivity, exit_values_1, p0_values,
    Fin.sum_univ_succ, Fin.sum_univ_zero, Matrix.cons_val_zero, Matrix.cons_val_succ]

theorem rational_second_activity : (51 / 100 : ℚ) < ratActivity q2 p1 := by
  norm_num [ratActivity, exit_values_2, p1_values,
    Fin.sum_univ_succ, Fin.sum_univ_zero, Matrix.cons_val_zero, Matrix.cons_val_succ]

theorem rational_average_activity :
    (63 / 125 : ℚ) < (ratActivity q1 p0 + ratActivity q2 p1) / 2 := by
  norm_num [ratActivity, exit_values_1, exit_values_2, p0_values, p1_values,
    Fin.sum_univ_succ, Fin.sum_univ_zero, Matrix.cons_val_zero, Matrix.cons_val_succ]

noncomputable def β0 : ℝ := Real.log (q0 : ℝ)
noncomputable def β1 : ℝ := Real.log (q1 : ℝ)
noncomputable def β2 : ℝ := Real.log (q2 : ℝ)

theorem parameter_order : 0 < β0 ∧ β0 < β1 ∧ β1 < β2 := by
  exact ⟨Real.log_pos (by norm_num [q0]),
    Real.log_lt_log (by norm_num [q0]) (by norm_num [q0, q1]),
    Real.log_lt_log (by norm_num [q1]) (by norm_num [q1, q2])⟩

theorem first_eq : model.firstActivity realEnergy β0 β1 = (ratActivity q1 p0 : ℝ) := by
  unfold RegularGraph.firstActivity β0 β1 p0
  rw [gibbs_eq_rat q0 (by norm_num [q0]), activity_eq_rat q1 (by norm_num [q1])]

theorem second_eq : model.secondActivity realEnergy β0 β1 β2 = (ratActivity q2 p1 : ℝ) := by
  unfold RegularGraph.secondActivity β0 β1 β2 p1 p0
  rw [gibbs_eq_rat q0 (by norm_num [q0]), update_eq_rat q1 (by norm_num [q1]),
    activity_eq_rat q2 (by norm_num [q2])]

theorem exact_eight_state_counterexample :
    graph.Connected ∧ (∀ i, (neighbors graph i).card = 3) ∧
    Function.Injective realEnergy ∧ 0 < β0 ∧ β0 < β1 ∧ β1 < β2 ∧
    0 < β2⁻¹ ∧ β2⁻¹ < β1⁻¹ ∧ β1⁻¹ < β0⁻¹ ∧
    249 / 500 < model.firstActivity realEnergy β0 β1 ∧
    51 / 100 < model.secondActivity realEnergy β0 β1 β2 ∧
    63 / 125 < model.averageActivity realEnergy β0 β1 β2 := by
  obtain ⟨h₀, h₀₁, h₁₂⟩ := parameter_order
  have h₁ := h₀.trans h₀₁
  have h₂ := h₁.trans h₁₂
  refine ⟨graph_connected, graph_regular, energy_injective, h₀, h₀₁, h₁₂,
    inv_pos.mpr h₂, (inv_lt_inv₀ h₂ h₁).2 h₁₂, (inv_lt_inv₀ h₁ h₀).2 h₀₁, ?_, ?_, ?_⟩
  · rw [first_eq]
    have h : ((249 / 500 : ℚ) : ℝ) < (ratActivity q1 p0 : ℝ) :=
      Rat.cast_lt.mpr rational_first_activity
    simpa only [Rat.cast_div, Rat.cast_ofNat] using h
  · rw [second_eq]
    have h : ((51 / 100 : ℚ) : ℝ) < (ratActivity q2 p1 : ℝ) :=
      Rat.cast_lt.mpr rational_second_activity
    simpa only [Rat.cast_div, Rat.cast_ofNat] using h
  · rw [RegularGraph.averageActivity, first_eq, second_eq]
    have h : ((63 / 125 : ℚ) : ℝ) < (((ratActivity q1 p0 + ratActivity q2 p1) / 2 : ℚ) : ℝ) :=
      Rat.cast_lt.mpr rational_average_activity
    simpa only [Rat.cast_div, Rat.cast_ofNat, Rat.cast_add] using h

